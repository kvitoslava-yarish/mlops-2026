# Copy to .env (git-ignored): cp .env.example .env
# Local-only defaults for the docker compose stack. Never commit real values.

# alerts.in.ua API token. Optional: without it, months after the pinned dataset
# are not extracted (see README, "Sources").
ALERTS_IN_UA_TOKEN=

# PostgreSQL 16: superuser + one user per database (airflow, mlflow, warehouse)
POSTGRES_PASSWORD=postgres
AIRFLOW_DB_PASSWORD=airflow
MLFLOW_DB_PASSWORD=mlflow
WAREHOUSE_DB_PASSWORD=warehouse

# MinIO (pgsty/silo). The same key pair is used by DVC, MLflow and the pipeline.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# Airflow 3 internal API signing key (any random string)
AIRFLOW_JWT_SECRET=change-me-local-only

# Host-side clients (make train / reproduce / snapshot)
MLFLOW_TRACKING_URI=http://localhost:5001
# MLflow 3 presigned downloads name minio:9000, which the host cannot resolve;
# this routes artifact downloads through the tracking server instead.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
WAREHOUSE_DSN=postgresql://warehouse:warehouse@localhost:5433/warehouse
S3_ENDPOINT_URL=http://localhost:9000
